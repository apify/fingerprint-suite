{
    "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "quoteProps": "preserve",
    "endOfLine": "lf",
    "ignorePatterns": [
        "**/node_modules",
        "**/dist",
        "**/coverage",
        "**/.turbo",
        "**/*.d.ts",
        "**/package.json",
        "**/*.md"
    ]
}
