{
    "name": "fingerprint-suite",
    "private": true,
    "type": "module",
    "version": "2.1.90",
    "description": "",
    "keywords": [
        "apify",
        "headless",
        "chrome",
        "puppeteer",
        "crawler",
        "scraper"
    ],
    "author": {
        "name": "Apify",
        "email": "support@apify.com",
        "url": "https://apify.com"
    },
    "contributors": [
        "Jan Curn <jan@apify.com>",
        "Marek Trunkat <marek@apify.com>",
        "Ondra Urban <ondra@apify.com>"
    ],
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apify/fingerprint-suite"
    },
    "bugs": {
        "url": "https://github.com/apify/fingerprint-suite/issues"
    },
    "scripts": {
        "clean": "turbo run clean",
        "build": "turbo run build",
        "postbuild": "node ./scripts/typescript-fixes.mjs",
        "prerelease": "pnpm build --force && turbo run copy --force --concurrency=1",
        "release": "./scripts/publish.sh",
        "test": "vitest run",
        "tsc-check-tests": "tsc --noEmit --project test/tsconfig.json",
        "lint": "oxlint packages test --tsconfig=tsconfig.json --type-aware",
        "lint:fix": "oxlint packages test --tsconfig=tsconfig.json --type-aware --fix",
        "format": "oxfmt packages test --write",
        "format:check": "oxfmt packages test --check",
        "buildNetwork": "turbo run build && ./scripts/netgen.sh && turbo run build && pnpm verifyModel",
        "verifyModel": "tsx ./scripts/verify-model.ts",
        "benchmark": "tsx ./test/antibot-services/live-testing/cloudflare.ts",
        "prepare": "husky"
    },
    "devDependencies": {
        "@apify/oxlint-config": "^0.4.1",
        "@apify/tsconfig": "^0.2.0",
        "@types/adm-zip": "^0.5.0",
        "@types/node": "^24.19.4",
        "@types/puppeteer": "^7.0.0",
        "@types/useragent": "^2.3.1",
        "browserslist": "^4.28.8",
        "fast-csv": "^5.0.0",
        "fingerprint-generator": "workspace:*",
        "fingerprint-injector": "workspace:*",
        "generator-networks-creator": "workspace:*",
        "globby": "^15.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "^7.0.2009",
        "playwright": "^1.51.1",
        "playwright-extra": "^4.3.6",
        "puppeteer": "^24.4.0",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "puppeteer-extra-plugin-user-preferences": "^2.4.1",
        "rimraf": "^6.0.0",
        "semver": "^7.3.8",
        "tsx": "4.21.0",
        "turbo": "^2.9.14",
        "typescript": "^7.0.2",
        "vitest": "^5.1.2"
    },
    "lint-staged": {
        "{packages,test}/**/*.{js,ts,mjs,mts,cjs,cts}": [
            "oxlint --fix --no-error-on-unmatched-pattern",
            "oxfmt --write --no-error-on-unmatched-pattern"
        ]
    },
    "packageManager": "pnpm@12.23.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.23.0",
            "onFail": "warn"
        }
    }
}
