{
    "name": "fingerprint-injector",
    "version": "2.1.89",
    "description": "Browser fingerprint injection library for Playwright and Puppeteer.",
    "homepage": "https://github.com/apify/fingerprint-suite",
    "engines": {
        "node": ">=22.13.0"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "dependencies": {
        "fingerprint-generator": "workspace:*"
    },
    "peerDependencies": {
        "playwright": "^1.22.2",
        "puppeteer": ">= 9.x"
    },
    "peerDependenciesMeta": {
        "playwright": {
            "optional": true
        },
        "puppeteer": {
            "optional": true
        }
    },
    "scripts": {
        "build": "pnpm clean && pnpm compile",
        "postbuild": "cp src/utils.js ../../README.md dist/",
        "clean": "rimraf ./dist",
        "compile": "tsc -p tsconfig.build.json",
        "copy": "tsx ../../scripts/copy.ts"
    },
    "author": {
        "name": "Apify",
        "email": "support@apify.com",
        "url": "https://apify.com"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apify/fingerprint-suite.git"
    }
}
