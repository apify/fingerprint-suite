{
    "name": "generator-networks-creator",
    "version": "2.1.89",
    "engines": {
        "node": ">=22.13.0"
    },
    "type": "module",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "generative-bayesian-network": "workspace:*",
        "node-fetch": "^2.6.7",
        "ua-parser-js": "^2.0.10",
        "zod": "^4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apify/fingerprint-suite.git"
    },
    "homepage": "https://github.com/apify/fingerprint-suite",
    "scripts": {
        "build": "pnpm compile && pnpm copyfiles",
        "clean": "rimraf ./dist",
        "compile": "tsc -p tsconfig.build.json",
        "copyfiles": "cp -r ./src/network_structures ./dist",
        "copy": "tsx ../../scripts/copy.ts"
    }
}
