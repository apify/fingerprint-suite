{
    "extends": "../tsconfig.json",
    "include": ["**/*", "../packages/*/src/**/*"],
    "exclude": ["antibot-services"],
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "sourceMap": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "strictNullChecks": false
    }
}
