{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "verbatimModuleSyntax": true,
        "allowJs": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "emitDecoratorMetadata": false,
        "declarationMap": false,
        "sourceMap": false,
        "incremental": false
    },
    "include": ["./packages/*/src/**/*"],
    "exclude": ["**/node_modules", "**/dist"]
}
